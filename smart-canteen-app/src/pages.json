{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/index/index_v2",
			"style": {
				"navigationBarTitleText": "首页",
				"navigationBarTextStyle": "white",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/category/category",
			"style": {
				"navigationBarTitleText": "点餐",
				"navigationBarBackgroundColor": "#fff",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/my/my",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/order/order",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "点餐"
			}
		},
		{
			"path": "pages/health-analysis/health-analysis",
			"style": {
				"navigationBarTitleText": "健康分析",
				"navigationStyle": "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages/detail",
			"pages": [
				{
					"path": "detail",
					"style": {
						"navigationBarTitleText": "详情"
					}
				}
			]
		},
		{
			"root": "pages/submit",
			"pages": [
				{
					"path": "submit",
					"style": {
						"navigationBarTitleText": "提交订单"
					}
				},
				{
					"path": "success",
					"style": {
						"navigationBarTitleText": "提交成功"
					}
				}
			]
		},
		{
			"root": "pages/address",
			"pages": [
				{
					"path": "address",
					"style": {
						"navigationBarTitleText": "地址管理"
					}
				}
			]
		},
		{
			"root": "pages/favorite",
			"pages": [
				{
					"path": "favorite",
					"style": {
						"navigationBarTitleText": "我的收藏",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "pages/addOrEditAddress",
			"pages": [
				{
					"path": "addOrEditAddress",
					"style": {
						"navigationBarTitleText": "新增/修改地址"
					}
				}
			]
		},
		{
			"root": "pages/remark",
			"pages": [
				{
					"path": "remark",
					"style": {
						"navigationBarTitleText": "备注"
					}
				}
			]
		},
		{
			"root": "pages/pay",
			"pages": [
				{
					"path": "pay",
					"style": {
						"navigationBarTitleText": "支付订单",
						"navigationStyle": "custom"
					}
				},
				{
					"path": "success",
					"style": {
						"navigationBarTitleText": "支付成功",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "pages/orderDetail",
			"pages": [
				{
					"path": "orderDetail",
					"style": {
						"navigationBarTitleText": "订单详情",
						"navigationStyle": "custom",
						"enablePullDownRefresh": true
					}
				}
			]
		},
		{
			"root": "pages/history",
			"pages": [
				{
					"path": "history",
					"style": {
						"navigationBarTitleText": "历史订单"
					}
				}
			]
		},
		{
			"root": "pages/updateMy",
			"pages": [
				{
					"path": "updateMy",
					"style": {
						"navigationBarTitleText": "信息设置"
					}
				}
			]
		},
		{
			"root": "pages/info-setting",
			"pages": [
				{
					"path": "info-setting",
					"style": {
						"navigationBarTitleText": "健康画像设置",
						"navigationStyle": "custom"
					}
				}
			]
		},
		{
			"root": "pages/user",
			"pages": [
				{
					"path": "weekly-report",
					"style": {
						"navigationBarTitleText": "消费周报",
						"navigationBarBackgroundColor": "#FF8C42",
						"navigationBarTextStyle": "white"
					}
				}
			]
		}
	],
	"preloadRule": {
		"pages/category/category": {
			"network": "all",
			"packages": [
				"pages/detail",
				"pages/submit"
			]
		},
		"pages/my/my": {
			"network": "all",
			"packages": [
				"pages/history",
				"pages/favorite",
				"pages/updateMy"
			]
		}
	},
	"lazyCodeLoading": "requiredComponents",
	"tabBar": {
		"color": "#999",
		"selectedColor": "#FF8C42",
		"backgroundColor": "#fff",
		"borderStyle": "white",
		"list": [
			{
				"text": "首页",
				"pagePath": "pages/index/index_v2",
				"iconPath": "static/icons/shouye.png",
				"selectedIconPath": "static/icons/shouye.png"
			},
			{
				"text": "点餐",
				"pagePath": "pages/category/category",
				"iconPath": "static/icons/diancan.png",
				"selectedIconPath": "static/icons/diancan.png"
			},
			{
				"text": "健康分析",
				"pagePath": "pages/health-analysis/health-analysis",
				"iconPath": "static/icons/shujufenxi-baobeifenxi.png",
				"selectedIconPath": "static/icons/shujufenxi-baobeifenxi.png"
			},
			{
				"text": "我的",
				"pagePath": "pages/my/my",
				"iconPath": "static/icons/wode.png",
				"selectedIconPath": "static/icons/wode.png"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "智能食堂",
		"navigationBarBackgroundColor": "#FF9F43",
		"backgroundColor": "#F8F8F8"
	}
}
