<view class="page-container"><view class="blob blob-1"></view><view class="blob blob-2"></view><view class="blob blob-3"></view><view class="content-wrapper"><view class="custom-nav" style="{{'padding-top:' + c}}"><view class="back-btn glass-btn" bindtap="{{b}}"><uni-icons wx:if="{{a}}" u-i="a619e390-0" bind:__l="__l" u-p="{{a}}"></uni-icons></view><text class="page-title">订单详情</text><view class="placeholder"></view></view><view wx:if="{{d}}" class="loading-state"><uni-icons wx:if="{{e}}" u-i="a619e390-1" bind:__l="__l" u-p="{{e}}"></uni-icons><text style="margin-left:16rpx">加载中...</text></view><view wx:elif="{{f}}"><view class="{{['status-header', j]}}"><view class="status-icon-wrap"><view class="status-icon"><uni-icons wx:if="{{g}}" u-i="a619e390-2" bind:__l="__l" u-p="{{g}}"></uni-icons></view></view><view class="status-info"><text class="status-title">{{h}}</text><text class="status-subtitle">{{i}}</text></view></view><view wx:if="{{k}}" class="section-padding"><view class="ticket-card glass-panel receipt-edge"><view class="ticket-top"><view class="floor-tag"><uni-icons wx:if="{{l}}" u-i="a619e390-3" bind:__l="__l" u-p="{{l}}"></uni-icons><text>{{m}}</text></view><view class="pickup-number"><text class="prefix">{{n}}</text><text class="num">{{o}}</text></view><view class="hint-box"><text>请留意 <text class="highlight">{{p}}</text> 叫号屏</text></view></view><view class="divider-row"><view class="divider-dot left"></view><view class="divider-line"></view><view class="divider-dot right"></view></view><view class="ticket-bottom"><view class="info-row"><text class="label">预计取餐时间</text><text class="value accent">{{q}}</text></view><view class="info-row"><text class="label">取餐地点点点</text><text class="value">{{r}}</text></view></view></view><view class="ticket-shadow"></view></view><view wx:if="{{s}}" class="section-padding"><view class="reminder-box"><uni-icons wx:if="{{t}}" u-i="a619e390-4" bind:__l="__l" u-p="{{t}}"></uni-icons><text>请留意叫号屏，取餐后管理员将完成订单</text></view></view><view class="section-padding"><view class="glass-card"><view class="section-title"><uni-icons wx:if="{{v}}" u-i="a619e390-5" bind:__l="__l" u-p="{{v}}"></uni-icons><text>订单菜品</text><text class="item-count">共 {{w}} 件</text></view><view wx:if="{{x}}" class="item-list"><view wx:for="{{y}}" wx:for-item="item" wx:key="f" class="order-item"><image class="item-img" src="{{item.a}}" mode="aspectFill"></image><view class="item-info"><text class="item-name">{{item.b}}</text><text class="item-flavor">{{item.c}}</text></view><view class="item-right"><text class="item-price">¥{{item.d}}</text><text class="item-count-tag">x{{item.e}}</text></view></view></view><view wx:else class="empty-list"><text>暂无菜品信息</text></view></view></view><view class="section-padding"><view class="glass-card"><view class="section-title"><uni-icons wx:if="{{z}}" u-i="a619e390-6" bind:__l="__l" u-p="{{z}}"></uni-icons><text>订单信息</text></view><view class="info-list"><view class="info-row"><text class="label">备注</text><text class="value">{{A}}</text></view><view class="info-row"><text class="label">餐具份数</text><text class="value">{{B}} 份</text></view><view class="info-row"><text class="label">订单编号</text><text class="value selectable">{{C}}</text></view><view class="info-row"><text class="label">下单时间</text><text class="value">{{D}}</text></view><view class="info-row total-row"><text class="label">实付金额</text><text class="value price">¥{{E}}</text></view></view></view></view><view wx:if="{{F}}" class="section-padding"><view class="cancel-reason-box"><uni-icons wx:if="{{G}}" u-i="a619e390-7" bind:__l="__l" u-p="{{G}}"></uni-icons><text>取消原因：{{H}}</text></view></view><view wx:if="{{I}}" class="section-padding action-section"><button class="btn-cancel" bindtap="{{J}}">取消订单</button></view><view wx:if="{{K}}" class="section-padding action-section"><button class="btn-reorder" bindtap="{{L}}">再来一单</button></view><view wx:if="{{M}}" class="section-padding action-section"><button class="btn-complete" bindtap="{{N}}">我已成功取餐</button></view><view style="height:80rpx"></view></view><view wx:else class="error-state"><uni-icons wx:if="{{O}}" u-i="a619e390-8" bind:__l="__l" u-p="{{O}}"></uni-icons><text>订单数据加载失败</text><button class="btn-retry" bindtap="{{P}}">重试</button></view></view></view>