.page-container{min-height:100vh;background:#f0fdfa;position:relative;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif}@keyframes float{0%,to{transform:translate(0) rotate(0)}33%{transform:translate(30rpx,-50rpx) rotate(10deg)}66%{transform:translate(-20rpx,20rpx) rotate(-5deg)}}.blob{position:fixed;border-radius:50%;filter:blur(80rpx);z-index:0;opacity:.6;animation:float 10s infinite ease-in-out}.blob-1{top:-10%;left:-20%;width:600rpx;height:600rpx;background:rgba(5,184,156,.25);animation-delay:0s}.blob-2{top:30%;right:-20%;width:500rpx;height:500rpx;background:rgba(251,146,60,.15);animation-delay:-2s}.blob-3{bottom:-10%;left:10%;width:700rpx;height:700rpx;background:rgba(45,212,191,.2);animation-delay:-5s}.content-wrapper{position:relative;z-index:10;display:flex;flex-direction:column;min-height:100vh;padding:0 40rpx 60rpx;box-sizing:border-box}.custom-nav{display:flex;align-items:center;justify-content:space-between;padding-bottom:20rpx}.back-btn{width:80rpx;height:80rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;transition:transform .2s}.back-btn:active{transform:scale(.95)}.glass-btn{background:rgba(255,255,255,.6);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.8);box-shadow:0 4rpx 12rpx rgba(0,0,0,.05)}.page-title{font-size:36rpx;font-weight:700;color:#1f2937}.placeholder{width:80rpx}.status-header{display:flex;flex-direction:column;align-items:center;margin:40rpx 0 60rpx}.check-circle{width:160rpx;height:160rpx;border-radius:50%;background:linear-gradient(135deg,#00b89c 0%,#009688 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 20rpx 60rpx rgba(0,184,156,.35);margin-bottom:24rpx;position:relative}.check-circle:after{content:"";position:absolute;inset:-10rpx;border-radius:50%;border:2rpx solid rgba(0,184,156,.3);opacity:.5;animation:pulse 2s infinite}@keyframes pulse{0%{transform:scale(1);opacity:.5}to{transform:scale(1.2);opacity:0}}.status-title{font-size:48rpx;font-weight:800;color:#1f2937;letter-spacing:-1rpx;margin-bottom:8rpx}.status-subtitle{font-size:30rpx;color:#6b7280;font-weight:500}@keyframes slideUpFade{0%{opacity:0;transform:translateY(40rpx)}to{opacity:1;transform:translateY(0)}}.stagger-1{animation:slideUpFade .8s cubic-bezier(.2,.8,.2,1) forwards}.stagger-2{opacity:0;animation:slideUpFade .8s cubic-bezier(.2,.8,.2,1) .2s forwards}.stagger-3{opacity:0;animation:slideUpFade .8s cubic-bezier(.2,.8,.2,1) .4s forwards}.animate-check uni-icons{animation:scaleCheck .5s cubic-bezier(.175,.885,.32,1.275) .3s backwards}@keyframes scaleCheck{0%{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}.ticket-wrapper{position:relative;margin-bottom:40rpx}.ticket-card{background:rgba(255,255,255,.75);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.9);border-radius:40rpx 40rpx 0 0;box-shadow:0 24rpx 64rpx rgba(0,0,0,.08);padding-bottom:30rpx;position:relative;overflow:hidden}.ticket-card:before{content:"";position:absolute;top:0;left:0;right:0;height:200rpx;background:linear-gradient(180deg,rgba(255,255,255,.8),transparent);pointer-events:none}.receipt-edge{clip-path:polygon(0 0,100% 0,100% 100%,97% 99%,94% 100%,91% 99%,88% 100%,85% 99%,82% 100%,79% 99%,76% 100%,73% 99%,70% 100%,67% 99%,64% 100%,61% 99%,58% 100%,55% 99%,52% 100%,49% 99%,46% 100%,43% 99%,40% 100%,37% 99%,34% 100%,31% 99%,28% 100%,25% 99%,22% 100%,19% 99%,16% 100%,13% 99%,10% 100%,7% 99%,4% 100%,1% 99%,0 100%)}.ticket-shadow{position:absolute;bottom:-20rpx;left:40rpx;right:40rpx;height:40rpx;background:#000;opacity:.15;filter:blur(20rpx);border-radius:50%;z-index:-1}.ticket-top{display:flex;flex-direction:column;align-items:center;padding:60rpx 32rpx 40rpx;position:relative}.floor-tag{display:inline-flex;align-items:center;gap:10rpx;padding:10rpx 24rpx;border-radius:100rpx;background:#fff7ed;color:#f97316;font-size:24rpx;font-weight:700;border:1px solid rgba(249,115,22,.2);margin-bottom:20rpx}.pickup-label{font-size:26rpx;color:#6b7280;letter-spacing:4rpx;text-transform:uppercase;margin-bottom:4rpx}.pickup-number{display:flex;align-items:baseline;margin-bottom:30rpx}.pickup-number .prefix{font-size:60rpx;font-weight:800;color:#cbd5e1;margin-right:12rpx;transform:translateY(-8rpx)}.pickup-number .num{font-size:110rpx;font-weight:900;letter-spacing:-6rpx;line-height:1;background:linear-gradient(135deg,#00b89c 0%,#0d9488 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 4rpx 10rpx rgba(0,184,156,.25))}.hint-box{background:rgba(255,255,255,.6);padding:14rpx 30rpx;border-radius:20rpx;font-size:26rpx;color:#1f2937;border:1px solid rgba(0,0,0,.03)}.hint-box .highlight{font-weight:800;color:#00b89c}.divider-row{position:relative;display:flex;align-items:center;margin:10rpx 0}.divider-dot{position:absolute;width:40rpx;height:40rpx;background:#f0fdfa;border-radius:50%;box-shadow:inset 0 2rpx 6rpx rgba(0,0,0,.1);z-index:5}.divider-dot.left{left:-20rpx}.divider-dot.right{right:-20rpx}.divider-line{flex:1;border-bottom:4rpx dashed #e2e8f0;margin:0 50rpx;opacity:.6}.ticket-bottom{padding:40rpx 50rpx;display:flex;flex-direction:column;gap:24rpx}.info-row{display:flex;justify-content:space-between;align-items:center;font-size:28rpx}.info-row .label{color:#6b7280}.info-row .value{color:#1f2937;font-weight:600;font-size:30rpx;font-family:DIN Alternate,sans-serif}.info-row .value.price{font-size:36rpx;color:#1f2937}.spacer{flex:1;min-height:40rpx}.action-buttons{display:flex;flex-direction:column;gap:24rpx;padding-bottom:20rpx}.btn-primary{display:flex;align-items:center;justify-content:center;gap:12rpx;width:100%;height:108rpx;border-radius:36rpx;background:linear-gradient(135deg,#00b89c 0%,#009688 100%);color:#fff;font-size:32rpx;font-weight:700;border:none;box-shadow:0 12rpx 36rpx rgba(0,184,156,.4);transition:transform .2s,box-shadow .2s}.btn-primary:active{transform:scale(.98);box-shadow:0 6rpx 20rpx rgba(0,184,156,.3)}.btn-secondary{display:flex;align-items:center;justify-content:center;width:100%;height:108rpx;border-radius:36rpx;background:rgba(255,255,255,.6);border:2rpx solid #e5e7eb;color:#6b7280;font-size:30rpx;font-weight:600;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}.btn-secondary:active{background:rgba(0,0,0,.05)}
