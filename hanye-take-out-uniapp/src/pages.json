{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/index/index_v2",
			"style": {
				"navigationBarTitleText": "首页",
				"navigationBarTextStyle": "white",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/category/category",
			"style": {
				"navigationBarTitleText": "点餐",
				"navigationBarBackgroundColor": "#fff",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/my/my",
			"style": {
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/order/order",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "点餐"
			}
		},
		{
			"path": "pages/detail/detail",
			"style": {
				"navigationBarTitleText": "详情"
			}
		},
		{
			"path": "pages/submit/submit",
			"style": {
				"navigationBarTitleText": "提交订单"
			}
		},
		{
			"path": "pages/submit/success",
			"style": {
				"navigationBarTitleText": "提交成功"
			}
		},
		{
			"path": "pages/address/address",
			"style": {
				"navigationBarTitleText": "地址管理"
			}
		},
		{
			"path": "pages/addOrEditAddress/addOrEditAddress",
			"style": {
				"navigationBarTitleText": "新增/修改地址"
			}
		},
		{
			"path": "pages/remark/remark",
			"style": {
				"navigationBarTitleText": "备注"
			}
		},
		{
			"path": "pages/pay/pay",
			"style": {
				"navigationBarTitleText": "支付订单",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/pay/success",
			"style": {
				"navigationBarTitleText": "支付成功",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/orderDetail/orderDetail",
			"style": {
				"navigationBarTitleText": "订单详情",
				"navigationStyle": "custom",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/history/history",
			"style": {
				"navigationBarTitleText": "历史订单"
			}
		},
		{
			"path": "pages/updateMy/updateMy",
			"style": {
				"navigationBarTitleText": "信息设置"
			}
		}
	],
	"tabBar": {
		"color": "#333",
		"selectedColor": "#FF6B00",
		"backgroundColor": "#fff",
		"borderStyle": "white",
		"list": [
			{
				"text": "首页",
				"pagePath": "pages/index/index_v2",
				"iconPath": "static/tabs/home_default.png",
				"selectedIconPath": "static/tabs/home_selected.png"
			},
			{
				"text": "点餐",
				"pagePath": "pages/category/category",
				"iconPath": "static/tabbar/order.png",
				"selectedIconPath": "static/tabbar/order_active.png"
			},
			{
				"text": "我的",
				"pagePath": "pages/my/my",
				"iconPath": "static/tabs/user_default.png",
				"selectedIconPath": "static/tabs/user_selected.png"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#FF9F43",
		"backgroundColor": "#F8F8F8"
	}
}